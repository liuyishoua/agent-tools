{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentPackage",
  "type": "object",
  "required": ["title", "body", "media", "source_refs", "claims", "quality"],
  "properties": {
    "title": {"type": "string"},
    "body": {"type": "string"},
    "media": {"type": "array", "items": {"type": "object", "required": ["source_url", "origin", "usage_rights", "generated_label_required", "viewed"], "anyOf": [{"required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}}}, {"required": ["attachment_id"], "properties": {"attachment_id": {"type": "string", "minLength": 1}}}, {"required": ["asset_id"], "properties": {"asset_id": {"type": "string", "minLength": 1}}}], "properties": {"path": {"type": ["string", "null"]}, "source_url": {"type": ["string", "null"]}, "origin": {"enum": ["owner", "licensed", "generated"]}, "usage_rights": {"type": "string"}, "generated_label_required": {"type": "boolean"}, "viewed": {"type": "boolean"}}, "additionalProperties": true}},
    "source_refs": {"type": "array", "items": {"type": "object", "required": ["source_url", "usage"], "properties": {"source_url": {"type": "string"}, "usage": {"type": "string"}}, "additionalProperties": true}},
    "claims": {"type": "array", "items": {"type": "object", "required": ["text", "basis", "kind"], "properties": {"text": {"type": "string"}, "basis": {"type": "string"}, "kind": {"enum": ["verified_fact", "preference", "creative"]}}, "additionalProperties": true}},
    "quality": {"type": "object", "required": ["status", "observations", "missing"], "properties": {"status": {"enum": ["ready", "hold"]}, "observations": {"type": "array", "items": {"type": "string"}}, "missing": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
